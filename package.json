{
  "name": "healhub",
  "version": "0.2.0",
  "private": true,
  "description": "Healhub - Hospital Management & Healthcare Booking Platform (monorepo)",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:hospital": "npm run dev -w apps/hospital",
    "seed": "npm run seed -w apps/api",
    "clean": "turbo run clean && rimraf --glob node_modules/**/.next apps/*/node_modules"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.11.0",
  "dependencies": {}
}
